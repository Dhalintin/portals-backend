# Copy values into a Render environment group; do not commit real secrets.
NODE_ENV=production
NODE_VERSION=22
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DB_POOL_MAX=5
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12
CORS_ORIGINS=https://YOUR_FRONTEND_HOST
WEB_URL=https://YOUR_FRONTEND_HOST
# Leave false until the trusted proxy peer/network has been established.
TRUST_PROXY=false
EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@YOUR_VERIFIED_DOMAIN
RESEND_API_KEY=REPLACE_IN_RENDER_SECRET_SETTINGS
AUTH_EMAIL_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
# Render supplies PORT. Do not put server secrets in the frontend.
