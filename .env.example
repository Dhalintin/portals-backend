DATABASE_URL="postgresql://user:password@localhost:5432/school_portal?schema=public"
JWT_SECRET="your-super-strong-secret-change-this"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development
# Optional online parent payments. No checkout is offered without a school routing entry.
PAYSTACK_SECRET_KEY=
# Map each school UUID to its verified Paystack subaccount code (not a bank account number).
PAYSTACK_SCHOOL_SUBACCOUNTS={}
