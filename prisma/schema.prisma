// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum GlobalRole {
  SUPER_ADMIN   // Platform owner
  PLATFORM_ADMIN
  USER
}

enum OrgRole {
  SCHOOL_ADMIN
  TEACHER
  EXAM_OFFICER
  // We can add PARENT / STUDENT later if needed for logged-in portals
}

enum TermName {
  FIRST
  SECOND
  THIRD
}

enum PinStatus {
  UNUSED
  USED
  EXPIRED
  DISABLED
}

enum GenderType {
  MALE
  FEMALE
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String?
  googleId      String?    @unique  // NEW
  firstName     String
  lastName      String
  phone         String?    @unique
  avatarUrl     String?
  lastLoginAt   DateTime?  // NEW
  globalRole    GlobalRole @default(USER)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships   Membership[]
  createdOrgs   Organization[] @relation("OrgCreator")
  passwordResetTokens  PasswordResetToken[]
  

  classTeacherOf      Class[]               @relation("ClassTeacher")
  classSubjectTeaching ClassSubjectTeacher[]

  platformAdminAssignments PlatformAdminAssignment[] @relation("PlatformAdminAssignments")
  platformAdminAssignedBy  PlatformAdminAssignment[] @relation("PlatformAdminAssigner")

  @@index([email])
  @@index([globalRole])
  @@index([googleId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATION (School)
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique               // e.g. greenspring-lagos
  email           String?  @unique
  phone           String?
  logoUrl         String?
  primaryColor    String?  @default("#1e3a5f")
  accentColor     String?  @default("#0f766e")
  address         String?
  city            String?
  state           String?
  country         String   @default("Nigeria")
  isActive        Boolean  @default(true)
  onBoarded       Boolean  @default(false)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Optional branding / settings
  motto           String?
  schoolType      String?                       // Primary, Secondary, etc.

  creator         User?             @relation("OrgCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships     Membership[]
  academicSessions AcademicSession[]
  classes         Class[]
  subjects        Subject[]
  students        Student[]
  results         Result[]
  pins            Pin[]
  announcements   Announcement[]

  classSubjects          ClassSubject[]
  classSubjectTeachers ClassSubjectTeacher[]

  site            OrganizationSite?
  platformAdminAssignments PlatformAdminAssignment[]


  @@index([slug])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// MEMBERSHIP (User ↔ Organization)
// ─────────────────────────────────────────────────────────────────────────────

model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole
  isActive       Boolean  @default(true)
  joinedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([role])
}

// ─────────────────────────────────────────────────────────────────────────────
// ACADEMIC STRUCTURE
// ─────────────────────────────────────────────────────────────────────────────

model AcademicSession {
  id             String   @id @default(uuid())
  organizationId String
  name           String                          // "2025/2026"
  startDate      DateTime?
  endDate        DateTime?
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  terms          Term[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isCurrent])
}

model Term {
  id        String   @id @default(uuid())
  sessionId String
  name      TermName
  isCurrent Boolean  @default(false)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())

  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  results   Result[]
  pins      Pin[]

  @@unique([sessionId, name])
  @@index([sessionId])
}

model Class {
  id             String   @id @default(uuid())
  organizationId String
  name           String                          // "JSS 2", "SSS 1"
  arm            String?                         // "A", "Science", "Gold"
  level          String?                         // "Junior Secondary", "Primary"
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  students       Student[]
  results        Result[]

  classTeacherId String?
  classTeacher   User?   @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)

  subjects         ClassSubject[]
  subjectTeachers ClassSubjectTeacher[]

  @@unique([organizationId, name, arm])
  @@unique([organizationId, classTeacherId])
  @@index([organizationId])
  @@index([classTeacherId])
}

model Subject {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scores         Score[]

  classSubjects   ClassSubject[]
  classTeachers ClassSubjectTeacher[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// STUDENT
// ─────────────────────────────────────────────────────────────────────────────

model Student {
  id               String     @id @default(uuid())
  organizationId   String
  admissionNumber  String
  firstName        String
  lastName         String
  otherNames       String?
  gender           GenderType?
  classId          String?
  parentPhone      String?
  parentEmail      String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class            Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  results          Result[]
  pins             Pin[]

  @@unique([organizationId, admissionNumber])
  @@index([organizationId])
  @@index([classId])
  @@index([admissionNumber])
}

// ─────────────────────────────────────────────────────────────────────────────
// RESULTS (Core of the MVP)
// One Result per student per term.
// Scores are stored per subject under that Result.
// ─────────────────────────────────────────────────────────────────────────────

model Result {
  id             String   @id @default(uuid())
  organizationId String
  studentId      String
  termId         String
  classId        String?                          // denormalized for easy querying
  totalScore     Float?
  percentage     Float?
  position       Int?                             // class position
  grade          String?                          // overall grade if needed
  remark         String?                          // teacher / principal remark
  isPublished    Boolean  @default(false)
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term           Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  class          Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  scores         Score[]

  @@unique([studentId, termId])
  @@index([organizationId, termId])
  @@index([isPublished])
  @@index([classId, termId])
}

model Score {
  id        String  @id @default(uuid())
  resultId  String
  subjectId String
  ca1       Float?  @default(0)                   // Continuous Assessment 1
  ca2       Float?  @default(0)                   // Continuous Assessment 2
  exam      Float?  @default(0)
  total     Float?                                // ca1 + ca2 + exam
  grade     String?
  remark    String?

  result    Result  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([resultId, subjectId])
  @@index([resultId])
  @@index([subjectId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PIN SYSTEM (Core monetisation)
// ─────────────────────────────────────────────────────────────────────────────

model Pin {
  id             String    @id @default(uuid())
  code           String    @unique                 // the actual PIN parents type
  organizationId String
  termId         String
  studentId      String?                          // optional: pre-assign to a student
  status         PinStatus @default(UNUSED)
  usedAt         DateTime?
  usedByIp       String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  term           Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  student        Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([organizationId, termId, status])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// ANNOUNCEMENTS (Simple notice board)
// ─────────────────────────────────────────────────────────────────────────────

model Announcement {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  body           String
  isPinned       Boolean  @default(false)
  isActive       Boolean  @default(true)
  publishedAt    DateTime @default(now())
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([isActive, publishedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Which subjects this class takes (curriculum)
model ClassSubject {
  id             String   @id @default(uuid())
  organizationId String
  classId        String
  subjectId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([organizationId])
  @@index([classId])
  @@index([subjectId])
}

model ClassSubjectTeacher {
  id             String   @id @default(uuid())
  organizationId String
  classId        String
  subjectId      String
  userId         String   
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([organizationId])
  @@index([userId])
  @@index([classId])
}


model OrganizationSite {
  id             String   @id @default(uuid())
  organizationId String   @unique

  // Public site
  heroTitle      String?
  heroSubtitle   String?
  aboutText      String?  // plain or markdown; keep simple for MVP
  footerText     String?

  // Contact extras (beyond org email/phone/address)
  whatsapp       String?
  websiteUrl     String?  // external site if any
  facebookUrl    String?
  instagramUrl   String?
  twitterUrl     String?

  // Feature flags / display
  showResultsCta Boolean  @default(true)
  showAbout      Boolean  @default(true)
  showContact    Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Schools a platform admin is responsible for
model PlatformAdminAssignment {
  id              String        @id @default(uuid())
  userId          String
  organizationId  String
  assignedById    String?     // SUPER_ADMIN who assigned
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation("PlatformAdminAssignments", fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedBy      User?         @relation("PlatformAdminAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}