// SchoolOS V1 — Portals base + SchoolOS modules
// KEEP: Organization branding, OrganizationSite (website)
// DROP: Pin / card monetization

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}


// ═══════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════

enum GlobalRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  USER
}

enum OrgRole {
  PROPRIETOR
  PRINCIPAL
  BURSAR
  SCHOOL_ADMIN
  TEACHER
  EXAM_OFFICER
  PARENT
  STUDENT
  STAFF
}

enum TermName {
  FIRST
  SECOND
  THIRD
}

enum GenderType {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ResultStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  OVERDUE
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  REVERSED
}

enum PaymentMethod {
  ONLINE
  BANK_TRANSFER
  CASH
  POS
  OTHER
}

enum PaymentSource {
  PAYSTACK
  MANUAL
  OTHER
}

enum SubscriptionPlan {
  FREE
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIAL
}

enum SponsorshipModel {
  SCHOOL
  PARENT
  SHARED
}

enum AuditAction {
  LOGIN
  LOGOUT
  STUDENT_CREATED
  STUDENT_UPDATED
  STUDENT_ARCHIVED
  FEE_CREATED
  INVOICE_CREATED
  PAYMENT_CREATED
  PAYMENT_REFUNDED
  RECEIPT_GENERATED
  RESULT_SUBMITTED
  RESULT_APPROVED
  RESULT_PUBLISHED
  ATTENDANCE_MODIFIED
  USER_INVITED
  ROLE_CHANGED
  SETTINGS_CHANGED
  OTHER
}

// ═══════════════════════════════════════════════════════════
// PLATFORM USER
// ═══════════════════════════════════════════════════════════

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?
  googleId     String?    @unique
  firstName    String
  lastName     String
  phone        String?    @unique
  avatarUrl    String?
  lastLoginAt  DateTime?
  globalRole   GlobalRole @default(USER)
  isActive     Boolean    @default(true)
  authVersion  Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  studentAccount           Student?
  memberships              Membership[]
  createdOrgs              Organization[]            @relation("OrgCreator")
  passwordResetTokens      PasswordResetToken[]
  invitationsSent          SchoolInvitation[] @relation("InvitationSender")
  announcementReads        AnnouncementRead[]
  authSessions             AuthSession[]
  classTeacherOf           Class[]                   @relation("ClassTeacher")
  classSubjectTeaching     ClassSubjectTeacher[]
  platformAdminAssignments PlatformAdminAssignment[] @relation("PlatformAdminAssignments")
  platformAdminAssignedBy  PlatformAdminAssignment[] @relation("PlatformAdminAssigner")
  parentProfiles           Parent[]
  attendanceRecorded       AttendanceRecord[]        @relation("AttendanceRecorder")
  auditLogs                AuditLog[]                @relation("AuditActor")
  uploadedFiles            File[]                    @relation("FileUploader")
  paymentsRecorded         Payment[]                 @relation("PaymentRecorder")

  @@index([email])
  @@index([globalRole])
  @@index([googleId])
}

model AuthSession {
  id                String    @id @default(uuid())
  userId            String
  schoolId          String?
  refreshTokenHash  String    @unique
  credentialVersion Int
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  school Organization? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([schoolId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════
// ORGANIZATION (school) — brand + public website KEPT
// ═══════════════════════════════════════════════════════════

enum MarkingScheme {
  CA20_20_EXAM60
  CA15_15_EXAM70
}

model Organization {
  termSubscriptions TermSubscription[]
  billingPayments BillingPayment[]
  offlineOperations OfflineOperation[]
  markingScheme MarkingScheme @default(CA20_20_EXAM60)
  examTimetables ExamTimetable[]
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  email        String?  @unique
  phone        String?
  logoUrl      String?
  primaryColor String?  @default("#1e3a5f")
  accentColor  String?  @default("#0f766e")
  address      String?
  city         String?
  state        String?
  country      String   @default("Nigeria")
  isActive     Boolean  @default(true)
  onBoarded    Boolean  @default(false)
  createdById  String?
  motto        String?
  schoolType   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  creator                  User?                     @relation("OrgCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships              Membership[]
  academicSessions         AcademicSession[]
  classes                  Class[]
  subjects                 Subject[]
  students                 Student[]
  results                  Result[]
  announcements            Announcement[]
  classSubjects            ClassSubject[]
  classSubjectTeachers     ClassSubjectTeacher[]
  site                     OrganizationSite?
  platformAdminAssignments PlatformAdminAssignment[]
  parents                  Parent[]
  parentStudentLinks       ParentStudent[]
  studentEnrollments       StudentEnrollment[]
  attendanceRecords        AttendanceRecord[]
  feeCategories            FeeCategory[]
  bankAccount              SchoolBankAccount?
  bankChanges              BankAccountChange[]
  feeStructures            FeeStructure[]
  invoices                 Invoice[]
  invoiceBatches           InvoiceBatch[]
  importBatches            ImportBatch[]
  invitations              SchoolInvitation[]
  payments                 Payment[]
  receipts                 Receipt[]
  auditLogs                AuditLog[]
  files                    File[]
  subscription             Subscription?
  gradeScales              GradeScale[]
  notificationOutbox       NotificationOutbox[]
  authSessions             AuthSession[]

  @@index([slug])
  @@index([isActive])
  @@index([name])
  @@index([isActive, name])
}

/// Public mini-site + theme customization (KEEP)
model OrganizationSite {
  id             String @id @default(uuid())
  organizationId String @unique

  heroTitle    String?
  heroSubtitle String?
  aboutText    String?
  footerText   String?

  whatsapp     String?
  websiteUrl   String?
  facebookUrl  String?
  instagramUrl String?
  twitterUrl   String?

  showResultsCta Boolean @default(true)
  showAbout      Boolean @default(true)
  showContact    Boolean @default(true)

  whyEyebrow  String?
  whyTitle    String?
  whyFeatures Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model PlatformAdminAssignment {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  assignedById   String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation("PlatformAdminAssignments", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedBy   User?        @relation("PlatformAdminAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  roles          OrgRole[] @default([])
  role           OrgRole
  isActive       Boolean  @default(true)
  joinedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([role])
}

// ═══════════════════════════════════════════════════════════
// ACADEMIC STRUCTURE (Portals-proven shape)
// ═══════════════════════════════════════════════════════════

model AcademicSession {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  startDate      DateTime?
  endDate        DateTime?
  isCurrent      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  terms         Term[]
  feeStructures FeeStructure[]
  enrollments   StudentEnrollment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isCurrent])
}

model Term {
  termSubscriptions TermSubscription[]
  markingScheme MarkingScheme?
  examTimetables ExamTimetable[]
  id        String    @id @default(uuid())
  sessionId String
  name      TermName
  isCurrent Boolean   @default(false)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  session       AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  results       Result[]
  feeStructures FeeStructure[]
  invoices      Invoice[]

  @@unique([sessionId, name])
  @@index([sessionId])
}

model Class {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  arm            String?
  level          String?
  isActive       Boolean  @default(true)
  classTeacherId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classTeacher    User?                 @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  students        Student[]
  results         Result[]
  subjects        ClassSubject[]
  subjectTeachers ClassSubjectTeacher[]
  attendance      AttendanceRecord[]
  enrollments     StudentEnrollment[]

  @@unique([organizationId, name, arm])
  @@unique([organizationId, classTeacherId])
  @@index([organizationId])
  @@index([classTeacherId])
}

model Subject {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scores        Score[]
  classSubjects ClassSubject[]
  classTeachers ClassSubjectTeacher[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ClassSubject {
  id             String   @id @default(uuid())
  organizationId String
  classId        String
  subjectId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([organizationId])
  @@index([classId])
  @@index([subjectId])
}

model ClassSubjectTeacher {
  id             String   @id @default(uuid())
  organizationId String
  classId        String
  subjectId      String
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([organizationId])
  @@index([userId])
  @@index([classId])
}

// ═══════════════════════════════════════════════════════════
// PEOPLE
// ═══════════════════════════════════════════════════════════

model Student {
  portalEnabled Boolean @default(true)
  activationCodeHash String? @unique
  activationCodeExpiresAt DateTime?
  id              String      @id @default(uuid())
  userId          String? @unique
  contactEmail    String?
  organizationId  String
  admissionNumber String
  firstName       String
  lastName        String
  otherNames      String?
  gender          GenderType?
  dateOfBirth     DateTime?
  classId         String?
  parentPhone     String?
  parentEmail     String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentRequests StudentParentRequest[]
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class        Class?               @relation(fields: [classId], references: [id], onDelete: SetNull)
  results      Result[]
  parentLinks  ParentStudent[]
  attendance   AttendanceRecord[]
  invoices     Invoice[]
  enrollments  StudentEnrollment[]

  @@unique([organizationId, admissionNumber])
  @@index([organizationId])
  @@index([classId])
  @@index([admissionNumber])
  @@index([organizationId, isActive])
}

model StudentEnrollment {
  id             String   @id @default(uuid())
  organizationId String
  studentId      String
  classId        String
  sessionId      String
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  session      AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId])
  @@index([organizationId])
  @@index([classId])
  @@index([sessionId])
}

model Parent {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  firstName      String
  lastName       String
  phone          String?
  email          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  children     ParentStudent[]
  linkRequests ChildLinkRequest[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@index([phone])
  @@index([email])
}

model ParentStudent {
  id             String   @id @default(uuid())
  organizationId String
  parentId       String
  studentId      String
  relation       String?
  isPrimary      Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([organizationId])
  @@index([studentId])
}

// ═══════════════════════════════════════════════════════════
// ATTENDANCE
// ═══════════════════════════════════════════════════════════

model AttendanceRecord {
  id             String           @id @default(uuid())
  organizationId String
  studentId      String
  classId        String
  date           DateTime         @db.Date
  status         AttendanceStatus
  note           String?
  recordedById   String?
  /// Client-generated id for offline sync (optional)
  clientKey      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([organizationId, date])
  @@index([classId, date])
  @@index([studentId])
  @@unique([organizationId, clientKey])
}

// ═══════════════════════════════════════════════════════════
// RESULTS
// ═══════════════════════════════════════════════════════════

model GradeScale {
  id             String   @id @default(uuid())
  organizationId String
  name           String   @default("Default")
  bands          Json
  isDefault      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Result {
  id             String       @id @default(uuid())
  organizationId String
  studentId      String
  termId         String
  classId        String?
  totalScore     Float?
  percentage     Float?
  position       Int?
  grade          String?
  remark         String?
  status         ResultStatus @default(DRAFT)
  isPublished    Boolean      @default(false)
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  class        Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  scores       Score[]

  @@unique([studentId, termId])
  @@index([organizationId, termId])
  @@index([isPublished])
  @@index([classId, termId])
  @@index([organizationId, termId, isPublished])
  @@index([termId, isPublished])
}

model Score {
  id        String  @id @default(uuid())
  resultId  String
  subjectId String
  ca1       Float?  @default(0)
  ca2       Float?  @default(0)
  exam      Float?  @default(0)
  total     Float?
  grade     String?
  remark    String?

  result  Result  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([resultId, subjectId])
  @@index([resultId])
  @@index([subjectId])
}

// ═══════════════════════════════════════════════════════════
// FEES & PAYMENTS
// ═══════════════════════════════════════════════════════════

model FeeCategory {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  structureItems FeeStructureItem[]
  invoiceItems   InvoiceItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model FeeStructure {
  targetClassIds String[] @default([])
  autoBill Boolean @default(false)
  invoices Invoice[]
  id             String   @id @default(uuid())
  organizationId String
  name           String
  sessionId      String?
  termId         String?
  classId        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      AcademicSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  term         Term?              @relation(fields: [termId], references: [id], onDelete: SetNull)
  items        FeeStructureItem[]

  @@index([organizationId])
  @@index([termId])
  @@index([sessionId])
}

model FeeStructureItem {
  id             String @id @default(uuid())
  feeStructureId String
  feeCategoryId  String
  amountNgn      Int

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeCategory  FeeCategory  @relation(fields: [feeCategoryId], references: [id], onDelete: Restrict)

  @@unique([feeStructureId, feeCategoryId])
  @@index([feeCategoryId])
}

model Invoice {
  feeStructureId String?
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  @@unique([feeStructureId, studentId])
  id             String        @id @default(uuid())
  organizationId String
  studentId      String
  termId         String?
  batchId        String?
  invoiceNumber  String
  status         InvoiceStatus @default(ISSUED)
  totalNgn       Int           @default(0)
  paidNgn        Int           @default(0)
  outstandingNgn Int           @default(0)
  dueDate        DateTime?
  issuedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term         Term?               @relation(fields: [termId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  allocations  PaymentAllocation[]
  receipts     Receipt[]
  batch        InvoiceBatch?       @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([studentId])
  @@index([termId])
  @@index([batchId])
}

model ImportBatch {
  id             String @id @default(uuid())
  organizationId String
  kind           String
  idempotencyKey String
  requestHash    String
  result         Json
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, idempotencyKey])
}

model InvoiceBatch {
  id             String   @id @default(uuid())
  organizationId String
  idempotencyKey String
  requestHash    String
  createdAt      DateTime @default(now())
  invoices       Invoice[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
}

model InvoiceItem {
  id            String  @id @default(uuid())
  invoiceId     String
  feeCategoryId String?
  description   String
  amountNgn     Int

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeCategory FeeCategory? @relation(fields: [feeCategoryId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([feeCategoryId])
}

model Payment {
  id                String        @id @default(uuid())
  organizationId    String
  amountNgn         Int
  status            PaymentStatus @default(PENDING)
  method            PaymentMethod @default(OTHER)
  source            PaymentSource @default(MANUAL)
  providerReference String?       @unique
  providerPayload   Json?
  paidAt            DateTime?
  note              String?
  recordedById      String?
  idempotencyKey    String?
  requestHash       String?
  reversedAt        DateTime?
  reversalReason    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recordedBy   User?               @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  allocations  PaymentAllocation[]
  receipts     Receipt[]

  @@index([organizationId, status])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, providerReference])
}

model PaymentAllocation {
  itemAllocations Json?
  id        String @id @default(uuid())
  paymentId String
  invoiceId String
  amountNgn Int
  reversedAt DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([invoiceId])
}

model Receipt {
  items Json?
  id             String   @id @default(uuid())
  organizationId String
  paymentId      String
  invoiceId      String?
  receiptNumber  String
  amountNgn      Int
  voidedAt       DateTime?
  issuedAt       DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, receiptNumber])
  @@index([paymentId])
  @@index([invoiceId])
}

// ═══════════════════════════════════════════════════════════
// COMMUNICATION, FILES, SUBSCRIPTION, AUDIT
// ═══════════════════════════════════════════════════════════

model Announcement {
  id             String    @id @default(uuid())
  organizationId String
  title          String
  body           String
  isPinned       Boolean   @default(false)
  isActive       Boolean   @default(true)
  isPublished    Boolean   @default(false)
  publishAt      DateTime?
  publishedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reads AnnouncementRead[]

  @@index([organizationId])
  @@index([organizationId, isPublished, isActive])
  @@index([isPublished, publishAt])
  @@index([organizationId, isActive, publishedAt])
}


model AnnouncementRead {
  announcementId String
  userId String
  readAt DateTime @default(now())
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([announcementId, userId])
  @@index([userId])
}


model File {
  id             String   @id @default(uuid())
  organizationId String
  uploaderId     String?
  key            String
  url            String
  mimeType       String?
  sizeBytes      Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploader     User?        @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([uploaderId])
}

model Subscription {
  billingStartedAt DateTime @default(now())
  paymentSchedule String @default("TWO_INSTALMENTS")
  schoolSharePercent Int @default(100)
  accessUntil DateTime?
  id               String             @id @default(uuid())
  organizationId   String             @unique
  plan             SubscriptionPlan   @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  studentCap       Int                @default(100)
  sponsorship      SponsorshipModel   @default(SCHOOL)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String      @id @default(uuid())
  organizationId String?
  actorId        String?
  action         AuditAction
  entity         String?
  entityId       String?
  metadata       Json?
  requestId      String?
  createdAt      DateTime    @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([action])
}

enum NotificationType {
  ATTENDANCE_ABSENCE
  FEE_REMINDER
  PAYMENT_SUCCESS
  RECEIPT
  RESULT_PUBLISHED
  ANNOUNCEMENT
  GENERAL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model NotificationOutbox {
  id             String             @id @default(uuid())
  organizationId String
  type           NotificationType
  status         NotificationStatus @default(PENDING)
  /// WhatsApp number, email, or userId depending on channel
  recipient      String
  channel        String             @default("whatsapp") // whatsapp | sms | email | inapp
  title          String?
  body           String
  /// Structured payload for the provider (links, metadata, etc.)
  payload        Json?
  /// Optional link back to the entity that triggered it
  entityType     String?
  entityId       String?
  scheduledAt    DateTime           @default(now())
  sentAt         DateTime?
  error          String?
  attempts       Int                @default(0)
  eventKey       String?
  requestHash    String?
  lockedAt       DateTime?
  nextAttemptAt  DateTime           @default(now())
  expiresAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([status, scheduledAt])
  @@index([entityType, entityId])
  @@unique([organizationId, eventKey])
}

model SchoolInvitation {
  id             String @id @default(uuid())
  organizationId String
  email          String
  firstName      String
  lastName       String
  phone          String?
  role           OrgRole
  parentId       String?
  tokenHash      String @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  @@index([organizationId, email])
}

model AuthEmail {
  id             String @id @default(uuid())
  recipient      String
  subject        String
  encryptedText  String?
  status         String @default("PENDING")
  attempts       Int @default(0)
  nextAttemptAt  DateTime @default(now())
  lockedAt       DateTime?
  expiresAt      DateTime
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  @@index([status, nextAttemptAt])
}

model SchoolBankAccount {
 organizationId String @id
 encryptedDetails String
 version Int @default(1)
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
}
model BankAccountChange {
 id String @id @default(uuid())
 organizationId String
 requesterId String
 email String
 encryptedDetails String
 codeHash String
 expectedVersion Int
 attempts Int @default(0)
 expiresAt DateTime
 usedAt DateTime?
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 @@index([organizationId, createdAt])
}

model ExamTimetable {
  id String @id @default(uuid())
  organizationId String
  termId String
  kind String @default("EXAM")
  format Json?
  groups Json?
  title String @default("Exam timetable")
  entries Json @default("[]")
  version Int @default(1)
  publishedSnapshot Json?
  publishedVersion Int?
  publishedAt DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  term Term @relation(fields: [termId], references: [id], onDelete: Cascade)
  @@unique([organizationId, termId, kind])
}

model OfflineOperation {
 id String @id
 organizationId String
 actorId String
 requestHash String
 response Json
 status Int
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 @@index([organizationId,actorId])
}

model ChildLinkRequest {
 id String @id @default(uuid())
 organizationId String
 parentId String
 childName String
 childKey String
 className String?
 note String?
 status String @default("PENDING")
 studentId String?
 reviewerId String?
 reviewNote String?
 reviewedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)
 @@unique([parentId, childKey])
 @@index([organizationId, status, createdAt])
}

model StudentParentRequest {
 id String @id @default(uuid())
 organizationId String
 studentId String
 email String
 status String @default("PENDING")
 reviewNote String?
 reviewerId String?
 reviewedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 student Student @relation(fields:[studentId],references:[id],onDelete:Cascade)
 @@unique([studentId,email])
 @@index([organizationId,status,createdAt])
}


model TermSubscription {
 id String @id @default(uuid())
 organizationId String
 termId String
 unitPriceNgn Int @default(300)
 annualPrepaid Boolean @default(false)
 sponsorship SponsorshipModel @default(SCHOOL)
 schoolSharePercent Int @default(100)
 startDate DateTime
 endDate DateTime
 balanceDueAt DateTime
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 term Term @relation(fields:[termId],references:[id],onDelete:Restrict)
 seats SubscriptionSeat[]
 allocations BillingAllocation[]
 payments BillingPayment[]
 @@unique([organizationId,termId])
 @@index([organizationId,balanceDueAt])
}
model SubscriptionSeat {
 id String @id @default(uuid())
 invoiceId String
 studentId String
 studentName String
 admissionNumber String
 createdAt DateTime @default(now())
 invoice TermSubscription @relation(fields:[invoiceId],references:[id],onDelete:Cascade)
 @@unique([invoiceId,studentId])
}
model BillingPayment {
 id String @id @default(uuid())
 organizationId String
 invoiceId String
 studentId String?
 actorId String
 amountNgn Int
 channel String
 status String @default("PENDING")
 reference String @unique
 externalReference String? @unique
 idempotencyKey String
 requestHash String
 note String?
 reviewedById String?
 reviewedAt DateTime?
 paidAt DateTime?
 checkoutUrl String?
 annual Boolean @default(false)
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 invoice TermSubscription @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
 allocations BillingAllocation[]
 @@unique([organizationId,idempotencyKey])
 @@index([status,createdAt])
}
model BillingAllocation {
 id String @id @default(uuid())
 paymentId String
 invoiceId String
 amountNgn Int
 payment BillingPayment @relation(fields:[paymentId],references:[id],onDelete:Restrict)
 invoice TermSubscription @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
 @@unique([paymentId,invoiceId])
}
model PlatformBillingSettings {
 id String @id @default("billing")
 bankName String @default("")
 accountName String @default("")
 accountNumber String @default("")
 supportEmail String @default("")
 updatedAt DateTime @updatedAt
}
